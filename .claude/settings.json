{
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(git add *)",
      "Bash(git remote -v)",
      "Bash(git config user.name *)",
      "Bash(git config user.email *)",
      "Bash(git config --get *)",
      "Bash(gh repo view*)",
      "Bash(gh repo list*)",
      "Bash(gh pr view *)",
      "Bash(gh search *)",
      "WebSearch",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:astro.build)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:github.com)",
      "mcp__claude_ai_GitLab__list_merge_requests",
      "mcp__claude_ai_GitLab__list_events",
      "mcp__claude_ai_GitLab__get_file_contents",
      "mcp__claude_ai_GitLab__get_repository_tree"
    ],
    "deny": [
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo rename *)",
      "Bash(gh gist *)",
      "Bash(gh api -X *)",
      "Bash(gh api * -X *)",
      "Bash(gh api --method *)",
      "Bash(gh api * --method *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --field *)",
      "Bash(gh api * --raw-field *)",
      "Bash(gh api * --input *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d*)",
      "Bash(git push * +*)",
      "Bash(git push * :*)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git config --global*)",
      "Bash(git config --system*)",
      "Bash(git config *core.*)",
      "Bash(git config *alias.*)",
      "Bash(git config *filter.*)",
      "Bash(git config *credential.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-before-commit.sh\"",
            "timeout": 900
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  }
}
